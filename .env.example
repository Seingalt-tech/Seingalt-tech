# Notion API Configuration
# Créer une intégration Notion sur https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IDs de vos databases Notion (trouvables dans l'URL de votre page)
# Exemple: https://www.notion.so/votreespace/12345678901234567890?v=...
#          L'ID est: 12345678901234567890
NOTION_PROJECTS_DATABASE_ID=your_projects_database_id_here
NOTION_BLOG_DATABASE_ID=your_blog_database_id_here

# Configuration optionnelle
NEXT_PUBLIC_SITE_URL=http://localhost:3000
