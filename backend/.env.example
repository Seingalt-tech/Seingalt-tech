# ==================== Server ====================
PORT=3001
NODE_ENV=development

# ==================== Authentication ====================
# API Key pour l'authentification (à changer en production!)
API_KEY=your-secure-api-key-here

# ==================== CORS ====================
# URL du frontend autorisée
CORS_ORIGIN=http://localhost:3000

# ==================== Notion API ====================
# Clé d'API Notion (obtenir depuis https://www.notion.so/my-integrations)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxx

# IDs des bases de données Notion
NOTION_DB_CHARACTERS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_CHAPTERS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_SCENES=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_TIMELINE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================== N8N ====================
# URL de base de votre instance N8N
N8N_BASE_URL=http://localhost:5678

# URL du webhook N8N (optionnel, si différent de baseUrl/webhook)
N8N_WEBHOOK_URL=

# API Key N8N (si authentification activée)
N8N_API_KEY=
